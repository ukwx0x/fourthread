{
  "name": "fourthread",
  "version": "0.2.1",
  "description": "Local-first 4-bot assistant: one shared thread, shared memory, zero cloud.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fourthread": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
